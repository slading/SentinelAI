# Public production defaults: read-only API and no billable LLM requests.
SENTINELAI_PRIVILEGED_MODE=disabled
SENTINELAI_LLM_MODE=mock

# Optional exact-origin list for deliberate cross-origin browser access.
# Same-origin dashboard requests do not need CORS.
# SENTINELAI_CORS_ORIGINS=https://demo.example.com,http://localhost:3000

# Controlled non-production testing only. Generate a unique random value with at
# least 32 ASCII characters; do not commit the actual value or put it in a browser.
# ENVIRONMENT=development
# SENTINELAI_PRIVILEGED_MODE=api_key
# SENTINELAI_PRIVILEGED_API_KEY=<local-only-random-secret-at-least-32-characters>

# Live Groq is an explicit opt-in for local/private work only. When set to live,
# provide a real key through the server environment or an untracked root .env.
# SENTINELAI_LLM_MODE=live
# GROQ_API_KEY=<real-server-side-groq-key>
